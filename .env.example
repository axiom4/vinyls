SECRET_KEY=change-me-generate-with-python-c-"import secrets;print(secrets.token_urlsafe(50))"
DEBUG=True
ALLOWED_HOSTS=localhost
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000

# Production only (DEBUG=False): HSTS seconds, e.g. 31536000
#SECURE_HSTS_SECONDS=0
#SECURE_HSTS_INCLUDE_SUBDOMAINS=True
#SECURE_HSTS_PRELOAD=True

# External database (optional; without it, local SQLite is used). Also install the driver:
#   PostgreSQL: pip install "psycopg[binary]"    MySQL: pip install mysqlclient
#DATABASE_URL=postgres://user:password@host:5432/db_name

# Redis cache (optional; without it, the process's local memory is used)
#REDIS_URL=redis://localhost:6379/1

# Cache duration for external API responses in seconds (default 86400 = 1 day)
#EXTERNAL_API_CACHE_SECONDS=86400

# Production behind nginx (see deploy/nginx/)
#DEBUG=False
#ALLOWED_HOSTS=vinyl.example.com
#BEHIND_PROXY=True
#CSRF_TRUSTED_ORIGINS=https://vinyl.example.com
#WEBAUTHN_RP_ID=vinyl.example.com
#WEBAUTHN_ORIGIN=https://vinyl.example.com
#SECURE_HSTS_SECONDS=0
